{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/run.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\run.py\"",
            "timeout": 30,
            "async": false,
            "additionalContextLimit": 6000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/run.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\run.py\"",
            "timeout": 30,
            "async": false
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/run.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\run.py\"",
            "timeout": 30,
            "async": false,
            "additionalContextLimit": 6000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/run.py\"",
            "commandWindows": "python \"%PLUGIN_ROOT%\\hooks\\run.py\"",
            "timeout": 30,
            "async": false,
            "additionalContextLimit": 6000
          }
        ]
      }
    ]
  }
}
